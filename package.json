{
  "name": "my_project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:backend": "jest --testPathPattern=backend",
    "test:e2e": "playwright test",
    "start:backend": "node backend/start.js",
    "test:show-passed": "vitest run src/test/Login.test.jsx src/test/Homepage.test.jsx --reporter verbose",
    "test:all": "npm run test && npm run test:backend && npm run test:e2e"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.3.0",
    "react-speech-recognition": "^4.0.0",
    "react-type-animation": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/user-event": "^14.5.0",
  "@testing-library/react": "^14.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "jsdom": "^23.0.0",
    "supertest": "^6.3.0",
    "vite": "^6.2.0",
    "vitest": "^1.0.0"
  }
}
